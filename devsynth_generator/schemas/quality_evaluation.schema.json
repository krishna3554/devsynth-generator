{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QualityEvaluation",
  "description": "Structured quality scores for a developer conversation.",
  "type": "object",
  "required": ["dimensions"],
  "additionalProperties": false,
  "properties": {
    "dimensions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["name", "score", "reasoning"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "enum": ["technical_accuracy", "helpfulness", "clarity", "realism"]
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "reasoning": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
