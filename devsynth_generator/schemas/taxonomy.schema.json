{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeveloperConversationTaxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "categories",
    "subcategories",
    "intents",
    "task_types",
    "difficulties",
    "learning_stages",
    "conversation_lengths",
    "languages",
    "roles",
    "tools",
    "interaction_patterns"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "categories": { "$ref": "#/$defs/nonEmptyUniqueStringArray" },
    "subcategories": { "$ref": "#/$defs/nonEmptyUniqueStringArray" },
    "intents": { "$ref": "#/$defs/nonEmptyUniqueStringArray" },
    "task_types": { "$ref": "#/$defs/nonEmptyUniqueStringArray" },
    "difficulties": { "$ref": "#/$defs/nonEmptyUniqueStringArray" },
    "learning_stages": { "$ref": "#/$defs/nonEmptyUniqueStringArray" },
    "conversation_lengths": { "$ref": "#/$defs/nonEmptyUniqueStringArray" },
    "languages": { "$ref": "#/$defs/nonEmptyUniqueStringArray" },
    "roles": { "$ref": "#/$defs/nonEmptyUniqueStringArray" },
    "tools": { "$ref": "#/$defs/nonEmptyUniqueStringArray" },
    "interaction_patterns": { "$ref": "#/$defs/nonEmptyUniqueStringArray" }
  },
  "$defs": {
    "nonEmptyUniqueStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    }
  }
}
